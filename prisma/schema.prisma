generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Branch {
  id           Int                       @id @default(autoincrement())
  branchCode   String                    @unique @map("branch_code")
  name         String
  region       String
  status       String                    @default("active")
  managerName  String                    @map("manager_name")
  phone        String
  address      String?
  memo         String?
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  permissions      BranchProgramPermission[]
  institutions     Institution[]
  targets          SalesTarget[]
  aliases          BranchAlias[]
  onlyOneTargets   OnlyOneTarget[]

  @@map("branches")
}

model BranchAlias {
  id       Int    @id @default(autoincrement())
  branchId Int    @map("branch_id")
  name     String @unique
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_aliases")
}

model Program {
  id           Int                       @id @default(autoincrement())
  name         String
  totalIssues  Int                       @default(12) @map("total_issues")
  matchKeyword String?                   @map("match_keyword")
  isOnlyOne    Boolean                   @default(false) @map("is_only_one")
  permissions  BranchProgramPermission[]
  orders       SaleOrder[]
  targets      SalesTarget[]
  erpMappings  ErpProductMapping[]

  @@map("programs")
}

model SalesTarget {
  id        Int     @id @default(autoincrement())
  branchId  Int     @map("branch_id")
  programId Int     @map("program_id")
  year      Int
  quantity  Int     @default(0)
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([branchId, programId, year])
  @@map("sales_targets")
}

model BranchProgramPermission {
  id        Int     @id @default(autoincrement())
  branchId  Int     @map("branch_id")
  programId Int     @map("program_id")
  isEnabled Boolean @default(false) @map("is_enabled")
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([branchId, programId])
  @@map("branch_program_permissions")
}

model Institution {
  id        Int         @id @default(autoincrement())
  branchId  Int         @map("branch_id")
  name      String
  phone     String?
  address   String?
  status    String      @default("active")
  memo      String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders           SaleOrder[]
  onlyOneContracts OnlyOneContract[]

  @@map("institutions")
}

model SaleOrder {
  id            Int         @id @default(autoincrement())
  institutionId Int         @map("institution_id")
  programId     Int         @map("program_id")
  issueNumber   Int         @map("issue_number")
  orderDate     String      @map("order_date")
  quantity      Int         @default(0)
  createdAt     DateTime    @default(now()) @map("created_at")
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  program       Program     @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([institutionId, programId, issueNumber, orderDate])
  @@index([orderDate])
  @@index([issueNumber])
  @@map("sale_orders")
}

model OnlyOneContract {
  id            Int         @id @default(autoincrement())
  institutionId Int         @map("institution_id")
  classCount    Int         @map("class_count")
  startDate     String      @map("start_date")
  endDate       String?     @map("end_date")
  createdAt     DateTime    @default(now()) @map("created_at")
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@map("only_one_contracts")
}

model OnlyOneTarget {
  id         Int    @id @default(autoincrement())
  branchId   Int    @map("branch_id")
  year       Int
  classCount Int    @map("class_count")
  branch     Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, year])
  @@map("only_one_targets")
}

model ErpSkipRule {
  id       Int     @id @default(autoincrement())
  keyword1 String
  keyword2 String?

  @@map("erp_skip_rules")
}

model ErpProductMapping {
  id          Int     @id @default(autoincrement())
  productName String  @unique
  programId   Int     @map("program_id")
  issueNumber Int     @map("issue_number")
  program     Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("erp_product_mappings")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("user")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
