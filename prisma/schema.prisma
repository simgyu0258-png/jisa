generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id           Int                       @id @default(autoincrement())
  branchCode   String                    @unique @map("branch_code")
  name         String
  region       String
  status       String                    @default("active")
  managerName  String                    @map("manager_name")
  phone        String
  address      String?
  memo         String?
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  permissions  BranchProgramPermission[]
  institutions Institution[]
  targets      SalesTarget[]

  @@map("branches")
}

model Program {
  id          Int                       @id @default(autoincrement())
  name        String
  totalIssues Int                       @default(12) @map("total_issues")
  permissions BranchProgramPermission[]
  orders      SaleOrder[]
  targets     SalesTarget[]

  @@map("programs")
}

model SalesTarget {
  id        Int     @id @default(autoincrement())
  branchId  Int     @map("branch_id")
  programId Int     @map("program_id")
  year      Int
  quantity  Int     @default(0)
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([branchId, programId, year])
  @@map("sales_targets")
}

model BranchProgramPermission {
  id        Int     @id @default(autoincrement())
  branchId  Int     @map("branch_id")
  programId Int     @map("program_id")
  isEnabled Boolean @default(false) @map("is_enabled")
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([branchId, programId])
  @@map("branch_program_permissions")
}

model Institution {
  id        Int         @id @default(autoincrement())
  branchId  Int         @map("branch_id")
  name      String
  phone     String?
  address   String?
  status    String      @default("active")
  memo      String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders    SaleOrder[]

  @@map("institutions")
}

model SaleOrder {
  id            Int         @id @default(autoincrement())
  institutionId Int         @map("institution_id")
  programId     Int         @map("program_id")
  issueNumber   Int         @map("issue_number")
  orderDate     String      @map("order_date")
  quantity      Int         @default(0)
  createdAt     DateTime    @default(now()) @map("created_at")
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  program       Program     @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([institutionId, programId, issueNumber])
  @@index([orderDate])
  @@index([issueNumber])
  @@map("sale_orders")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("user")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
